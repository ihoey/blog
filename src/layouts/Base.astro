---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import 'lxgw-wenkai-webfont/lxgwwenkai-regular.css';
import 'lxgw-wenkai-webfont/lxgwwenkai-bold.css';
import '../styles/global.css';
import '../styles/site.css';
import '../styles/sidebar.css';
import AuthorSidebar from '../components/AuthorSidebar.astro';
import '../styles/reading-marks.css';
import '../styles/article-headings.css';
import { legacyPublic } from '../data/legacy-public';
import ImageViewer from '../components/ImageViewer.astro';
import Companion from '../components/Companion.astro';
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  article?: boolean;
  comments?: boolean;
  date?: Date;
  updated?: Date;
}
const {
  title,
  description = site.motto,
  canonical = Astro.url.pathname,
  article = false,
  comments = false,
  date,
  updated,
} = Astro.props;
const fullTitle = title
  ? `${title} · ${site.name}`
  : `${site.name} · ${site.subtitle}`;
const canonicalURL = new URL(canonical, Astro.site).href;
const structuredData = date
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonicalURL,
      mainEntityOfPage: canonicalURL,
      datePublished: date.toISOString(),
      dateModified: (updated || date).toISOString(),
      image: new URL('/avatar.png', Astro.site).href,
      author: {
        '@type': 'Person',
        name: 'Ihoey',
        url: new URL('/about/', Astro.site).href,
      },
      publisher: { '@type': 'Organization', name: '梦魇小栈' },
    }
  : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta
      name="google-site-verification"
      content={legacyPublic.googleVerification}
    />
    <meta
      name="baidu-site-verification"
      content={legacyPublic.baiduVerification}
    />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/design/canopy.webp"
      fetchpriority="high"
    />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/images/icons/icon_192.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="梦魇小栈"
      href="/atom.xml"
    />
    <meta property="og:site_name" content="梦魇小栈" />
    <meta name="twitter:card" content="summary" />
    <meta property="og:locale" content="zh_CN" />
    <meta
      property="og:type"
      content={article && date ? 'article' : 'website'}
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta
      property="og:image"
      content={new URL('/avatar.png', Astro.site).href}
    />
    {date && (
      <meta property="article:published_time" content={date.toISOString()} />
    )}
    {updated && (
      <meta property="article:modified_time" content={updated.toISOString()} />
    )}
    <link
      rel="stylesheet"
      href="/lib/hitalk/3.0.0/secret-cat.9107f720cc5f.css"
      media="print"
      onload="this.media='all'"
    />
    {(article || comments) && (
      <link
        rel="stylesheet"
        href="/lib/hitalk/3.0.0/hitalk.aab370555dfe.css"
        media="print"
        onload="this.media='all'"
      />
    )}
    <title>{fullTitle}</title>
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')}
      />
    )}
    <script is:inline>
      document.documentElement.dataset.effects = matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches
        ? 'off'
        : 'on';
      try {
        const saved = localStorage.getItem('blog-theme');
        document.documentElement.dataset.theme =
          saved ||
          (matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <SiteHeader article={article} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <AuthorSidebar path={canonical} />
    <Companion title={title} />
    <ImageViewer />
    <SiteFooter />
    <script>
      import '../lib/appearance';
      import '../lib/site-services';
    </script>
    <script
      is:inline
      defer
      src="/lib/hitalk/3.0.0/secret-cat.a2815fc1af05.js"
    ></script>
    <script>
      import '../lib/page-enhancements';
    </script>
  </body>
</html>
