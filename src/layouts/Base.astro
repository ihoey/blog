---
import '../styles/global.css';
import '../styles/v2.css';
import Companion from '../components/Companion.astro';
interface Props { title?: string; description?: string; canonical?: string; article?: boolean; date?: Date; updated?: Date }
const { title, description = '心，若没有栖息的地方，到哪里都是流浪……', canonical = Astro.url.pathname, article = false, date, updated } = Astro.props;
const fullTitle = title ? `${title} · 梦魇小栈` : '梦魇小栈 · 专注于分享';
const canonicalURL = new URL(canonical, Astro.site).href;
const path = Astro.url.pathname;
const home = path === '/';
const nav = [['/', '首页', 'home'], ['/archives/', '归档', 'archive'], ['/tags/', '标签', 'tag'], ['/links/', '友链', 'link'], ['/guestbook/', '留言', 'comment'], ['/about/', '关于', 'user']];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/atom+xml" title="梦魇小栈" href="/atom.xml" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/avatar.png', Astro.site).href} />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <link rel="stylesheet" href="/lib/hitalk/3.0.0/secret-cat.9107f720cc5f.css" />
    {article && <link rel="stylesheet" href="/lib/hitalk/3.0.0/hitalk.aab370555dfe.css" />}
    <title>{fullTitle}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('blog-theme');
        document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.effects = localStorage.getItem('blog-effects') || 'on';
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class:list={['site-header', { 'home-header': home }]}>
      <div class="canopy" aria-hidden="true"></div>
      <div class="header-tools">
        <button class="theme-toggle" type="button" aria-label="切换昼夜主题" title="切换昼夜主题"><i class="icon icon-moon" aria-hidden="true"></i></button>
        <button class="effects-toggle" type="button" aria-pressed="true" title="开关个性效果"><i class="icon icon-magic" aria-hidden="true"></i><span>个性效果</span></button>
      </div>
      <div class="site-brand">{home ? <h1><a class="site-name" href="/" aria-label="梦魇小栈首页">梦魇小栈</a></h1> : <a class="site-name" href="/" aria-label="梦魇小栈首页">梦魇小栈</a>}<p>专注于分享</p></div>
      <nav class="main-nav" aria-label="主导航">
        {nav.map(([href, label, icon]) => <a href={href} aria-current={(href === '/' ? path === '/' || path.startsWith('/page/') : path.startsWith(href)) ? 'page' : undefined}><i class={`icon icon-${icon}`} aria-hidden="true"></i>{label}</a>)}
      </nav>
      {home && <p class="home-quote">心，若没有栖息的地方，到哪里都是流浪……</p>}
    </header>
    {article && <div class="reading-track" aria-hidden="true"><span id="reading-progress"></span></div>}
    <main id="main" tabindex="-1"><slot /></main>
    <Companion title={title} />
    <footer class="site-footer">
      <div class="footer-top"><a class="footer-name" href="/">梦魇小栈</a><span class="hitalk-secret" data-hitalk-secret><button type="button" aria-label="叫小猫出来" title="叫小猫出来"></button></span><a href="/atom.xml">订阅 RSS ↗</a></div>
      <p>心，若没有栖息的地方，到哪里都是流浪……</p>
      <p class="site-uptime">小栈已陪伴你 <span data-uptime>从 2015 年至今</span></p>
      <div class="footer-bottom"><span>© 2015–{new Date().getFullYear()} Ihoey</span><a href="https://beian.miit.gov.cn/" rel="noopener noreferrer" target="_blank">京ICP备15058055号-1</a><a href="https://github.com/ihoey" rel="noopener noreferrer" target="_blank">GitHub ↗</a></div>
    </footer>
    <button class="back-top" type="button" aria-label="返回顶部"><i class="icon icon-up" aria-hidden="true"></i><span data-scroll-label>回顶部</span></button>
    <script>import "../lib/appearance";</script>
    <script is:inline defer src="/lib/hitalk/3.0.0/secret-cat.a2815fc1af05.js"></script>
    <script>
      // Finish upgrading visitors who still have the Hexo worker controlling this origin.
      if (location.hostname === 'blog.ihoey.com' && 'serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(registrations => {
          for (const registration of registrations) {
            const worker = registration.active || registration.waiting || registration.installing;
            if (worker && new URL(worker.scriptURL).pathname === '/sw.js') registration.update();
          }
        }).catch(() => {});
      }
      document.querySelectorAll<HTMLElement>('.prose pre').forEach(pre => {
        const code = pre.querySelector('code');
        if (!code) return;
        const button = document.createElement('button'); button.type = 'button';
        button.className = 'copy-code'; button.textContent = '复制'; button.setAttribute('aria-label', '复制代码');
        button.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(code.textContent || ''); button.textContent = '已复制'; window.dispatchEvent(new Event('blog:copied'));  }
          catch { button.textContent = '请手动复制'; }
          window.setTimeout(() => { button.textContent = '复制'; }, 1800);
        });
        const wrapper = document.createElement('div'); wrapper.className = 'code-block';
        const label = document.createElement('span'); label.className = 'code-language'; label.textContent = pre.dataset.language || code.className.replace('language-', '') || 'CODE';
        pre.replaceWith(wrapper); wrapper.append(label, button, pre);
      });
    </script>
  </body>
</html>
