---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import { pageStructuredData } from '../lib/seo.mjs';
import 'lxgw-wenkai-webfont/lxgwwenkai-regular.css';
import 'lxgw-wenkai-webfont/lxgwwenkai-bold.css';
import '../styles/global.css';
import '../styles/site.css';
import '../styles/sidebar.css';
import AuthorSidebar from '../components/AuthorSidebar.astro';
import '../styles/reading-marks.css';
import '../styles/article-headings.css';
import { legacyPublic } from '../data/legacy-public';
import ImageViewer from '../components/ImageViewer.astro';
import Companion from '../components/Companion.astro';
interface Props {
  title?: string;
  seoTitle?: string;
  description?: string;
  canonical?: string;
  article?: boolean;
  comments?: boolean;
  date?: Date;
  updated?: Date;
  image?: string;
  tags?: string[];
  noindex?: boolean;
}
const {
  title,
  seoTitle = title,
  description = site.seoDescription,
  canonical = Astro.url.pathname,
  article = false,
  comments = false,
  date,
  updated,
  image,
  tags = [],
  noindex = false,
} = Astro.props;
const fullTitle = seoTitle
  ? `${seoTitle} · ${site.name}`
  : `${site.name} · ${site.subtitle}`;
const canonicalURL = new URL(canonical, Astro.site).href;
const socialImage = new URL(image || '/avatar.png', canonicalURL).href;
const structuredData = pageStructuredData({
  site,
  title: seoTitle || site.name,
  description,
  canonical,
  date,
  updated,
  image,
  tags,
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />
    <meta
      name="google-site-verification"
      content={legacyPublic.googleVerification}
    />
    <meta
      name="baidu-site-verification"
      content={legacyPublic.baiduVerification}
    />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/design/canopy.webp"
      fetchpriority="high"
    />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/images/icons/icon_192.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={site.name}
      href={new URL('/atom.xml', Astro.site).href}
    />
    <meta property="og:site_name" content={site.name} />
    <meta
      name="twitter:card"
      content={image ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta
      property="og:type"
      content={article && date ? 'article' : 'website'}
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    {date && (
      <meta property="article:published_time" content={date.toISOString()} />
    )}
    {updated && (
      <meta property="article:modified_time" content={updated.toISOString()} />
    )}
    <link
      rel="stylesheet"
      href="/lib/hitalk/3.0.0/secret-cat.9107f720cc5f.css"
      media="print"
      onload="this.media='all'"
    />
    {(article || comments) && (
      <link
        rel="stylesheet"
        href="/lib/hitalk/3.0.0/hitalk.aab370555dfe.css"
        media="print"
        onload="this.media='all'"
      />
    )}
    <title>{fullTitle}</title>
    {!noindex && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')}
      />
    )}
    <script is:inline>
      document.documentElement.dataset.effects = matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches
        ? 'off'
        : 'on';
      try {
        const saved = localStorage.getItem('blog-theme');
        document.documentElement.dataset.theme =
          saved ||
          (matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <SiteHeader article={article} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <AuthorSidebar path={canonical} />
    <Companion title={title} />
    <ImageViewer />
    <SiteFooter />
    <script>
      import '../lib/appearance';
      import '../lib/site-services';
    </script>
    <script
      is:inline
      defer
      src="/lib/hitalk/3.0.0/secret-cat.a2815fc1af05.js"
    ></script>
    <script>
      import '../lib/page-enhancements';
    </script>
  </body>
</html>
