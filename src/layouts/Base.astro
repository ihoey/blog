---
import 'lxgw-wenkai-webfont/lxgwwenkai-regular.css';
import 'lxgw-wenkai-webfont/lxgwwenkai-bold.css';
import '../styles/global.css';
import '../styles/v2.css';
import '../styles/sidebar.css';
import AuthorSidebar from '../components/AuthorSidebar.astro';
import '../styles/reading-marks.css';
import '../styles/article-headings.css';
import { navigationCurrent } from '../lib/paths.mjs';
import { legacyPublic } from '../data/legacy-public';
import ImageViewer from '../components/ImageViewer.astro';
import Companion from '../components/Companion.astro';
import FooterLandscape from '../components/FooterLandscape.astro';
interface Props { title?: string; description?: string; canonical?: string; article?: boolean; comments?: boolean; date?: Date; updated?: Date }
const { title, description = '心，若没有栖息的地方，到哪里都是流浪……', canonical = Astro.url.pathname, article = false, comments = false, date, updated } = Astro.props;
const fullTitle = title ? `${title} · 梦魇小栈` : '梦魇小栈 · 专注于分享';
const canonicalURL = new URL(canonical, Astro.site).href;
const structuredData = date ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description,
  url: canonicalURL, mainEntityOfPage: canonicalURL, datePublished: date.toISOString(),
  dateModified: (updated || date).toISOString(), image: new URL('/avatar.png', Astro.site).href,
  author: { '@type': 'Person', name: 'Ihoey', url: new URL('/about/', Astro.site).href },
  publisher: { '@type': 'Organization', name: '梦魇小栈' },
} : undefined;
const path = Astro.url.pathname;
const home = path === '/';
const BrandHeading = home ? 'h1' : 'div';
const nav = [['/', '首页', 'home'], ['/archives/index.html', '归档', 'archive'], ['/tags/index.html', '标签', 'tag'], ['/links/index.html', '友链', 'link'], ['/guestbook/index.html', '留言', 'comment'], ['/about/index.html', '关于', 'user']];

---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="google-site-verification" content={legacyPublic.googleVerification} />
    <meta name="baidu-site-verification" content={legacyPublic.baiduVerification} />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/images/icons/icon_192.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/atom+xml" title="梦魇小栈" href="/atom.xml" />
    <meta property="og:site_name" content="梦魇小栈" />
    <meta name="twitter:card" content="summary" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={article && date ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/avatar.png', Astro.site).href} />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <link rel="stylesheet" href="/lib/hitalk/3.0.0/secret-cat.9107f720cc5f.css" />
    {(article || comments) && <link rel="stylesheet" href="/lib/hitalk/3.0.0/hitalk.aab370555dfe.css" />}
    <title>{fullTitle}</title>
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />}
    <script is:inline>
      document.documentElement.dataset.effects = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'off' : 'on';
      try {
        const saved = localStorage.getItem('blog-theme');
        document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="site-topbar">
      <div class="topbar-inner">
        <a class="topbar-brand" href="/">梦魇小栈</a>
        <nav class="main-nav" aria-label="主导航">
          {nav.map(([href, label, icon]) => <a href={href} aria-current={navigationCurrent(path, href)}><i class={`icon icon-${icon}`} aria-hidden="true"></i>{label}</a>)}
        </nav>
        <div class="header-tools" role="group" aria-label="订阅与阅读偏好">
          {article && <span class="reading-track" aria-hidden="true"><span id="reading-progress"></span></span>}
          <a class="rss-subscribe" href="/atom.xml" aria-label="订阅 RSS" title="订阅 RSS">
            <svg class="tool-icon" viewBox="0 0 24 24" aria-hidden="true"><circle class="rss-dot" cx="6" cy="18" r="1.5"/><path class="rss-wave rss-wave-near" d="M5 11a8 8 0 0 1 8 8"/><path class="rss-wave rss-wave-far" d="M5 5a14 14 0 0 1 14 14"/></svg>
          </a>
          <button class="sidebar-toggle" type="button" popovertarget="author-sidebar" aria-controls="author-sidebar" aria-expanded="false" aria-label="展开作者与分类侧栏" title="展开作者与分类侧栏" hidden>
            <svg class="tool-icon" viewBox="0 0 24 24" aria-hidden="true"><rect class="panel-glass" x="15" y="5" width="5" height="14" rx="1"/><rect x="3" y="4" width="18" height="16" rx="3"/><path class="panel-divider" d="M15 4v16"/><path class="panel-indicator" d="M18 8v8"/></svg>
          </button>
          <button class="theme-toggle" type="button" aria-label="切换昼夜主题" title="切换昼夜主题">
            <svg class="tool-icon theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path class="moon-body" d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/><path class="moon-star" d="M18 3v4m-2-2h4"/></svg>
            <svg class="tool-icon theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle class="sun-core" cx="12" cy="12" r="4"/><path class="sun-rays" d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          </button>
        </div>
      </div>
    </div>
    <header class:list={['site-header', 'scenic-header', { 'home-header': home }]}>
      <div class="canopy" aria-hidden="true"></div>
      <div class="site-brand"><BrandHeading><a class="site-name" href="/" aria-label="梦魇小栈首页">{[...'梦魇小栈'].map((letter, index) => <span class="site-name-letter" style={`--letter-index:${index}`} aria-hidden="true">{letter}</span>)}</a></BrandHeading><p>专注于分享</p></div>
      <p class="home-quote">心，若没有栖息的地方，到哪里都是流浪……</p>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <AuthorSidebar path={canonical} />
    <Companion title={title} />
    <ImageViewer />
    <footer class="site-footer">
      <FooterLandscape />
      <div class="footer-content">
      <div class="footer-main">
        <div class="footer-identity">
          <div class="footer-brand"><a class="footer-name" href="/">梦魇小栈</a><span class="hitalk-secret" data-hitalk-secret><button type="button" aria-label="叫小猫出来" title="叫小猫出来"></button></span></div>
          <p class="footer-motto">心，若没有栖息的地方，到哪里都是流浪……</p>
          <nav class="footer-links" aria-label="小栈链接"><a class="footer-rss" href="/atom.xml"><i class="icon icon-rss" aria-hidden="true"></i> 订阅 RSS</a><a href="/sitemap.xml">站点地图</a><a href="https://github.com/ihoey" target="_blank" rel="noopener noreferrer"><i class="icon icon-github" aria-hidden="true"></i> GitHub</a><a class="footer-guestbook" href="/guestbook/index.html"><i class="icon icon-comment" aria-hidden="true"></i> 留个言 <span aria-hidden="true">↗</span></a></nav>
        </div>
        <div class="footer-status">
          <p class="uptime-label">博客已萌萌哒运行 <span class="uptime-face">●'◡'●)ﾉ♥</span></p>
          <p class="site-uptime"><span data-uptime>从 2015 年至今</span></p>
          <div class="site-traffic" aria-label="访问统计">
            <span id="busuanzi_container_site_uv"><i class="icon icon-user" aria-hidden="true"></i> 访客 <span id="busuanzi_value_site_uv">—</span></span>
            <span id="busuanzi_container_site_pv"><i class="icon icon-eye" aria-hidden="true"></i> 访问 <span id="busuanzi_value_site_pv">—</span> 次</span>
          </div>
        </div>
      </div>
      <div class="footer-bottom"><span>© 2015–{new Date().getFullYear()} <img class="footer-heart" src="/design/reward/like.svg" width="18" height="18" alt="" aria-hidden="true" /> 梦魇小栈</span><a href="https://beian.miit.gov.cn/" rel="noopener noreferrer" target="_blank">京ICP备15058055号-1</a><span>由 <a href="https://github.com/ihoey" rel="noopener noreferrer" target="_blank">Ihoey</a> 用心维护</span></div>
      </div>
    </footer>
    <button class="back-top" type="button" aria-label="返回顶部" hidden>
      <span class="back-top-label" aria-hidden="true">回到顶部</span>
      <svg class="back-top-rocket" viewBox="0 0 32 44" fill="none" aria-hidden="true">
        <g class="rocket-flame"><path d="M12 31q0 7 4 10 4-3 4-10"/><path d="M16 32v4"/></g>
        <g class="rocket-body"><path class="rocket-fins" d="m10 20-5 6v7l7-4m10-9 5 6v7l-7-4"/><path d="M10 29C7 16 11 7 16 3c5 4 9 13 6 26Z"/><path d="M11 29h10l-1 3h-8Z"/><circle cx="16" cy="16" r="3"/></g>
      </svg>
    </button>
    <script>import "../lib/appearance"; import "../lib/site-services";</script>
    <script is:inline defer src="/lib/hitalk/3.0.0/secret-cat.a2815fc1af05.js"></script>
    <script>
      // Finish upgrading visitors who still have the Hexo worker controlling this origin.
      if (location.hostname === 'blog.ihoey.com' && 'serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(registrations => {
          for (const registration of registrations) {
            const worker = registration.active || registration.waiting || registration.installing;
            if (worker && new URL(worker.scriptURL).pathname === '/sw.js') void registration.update().catch(() => {});
          }
        }).catch(() => {});
      }
      document.querySelectorAll<HTMLElement>('.prose pre').forEach(pre => {
        const code = pre.querySelector('code');
        if (!code) return;
        const button = document.createElement('button'); button.type = 'button';
        button.className = 'copy-code'; button.textContent = '复制'; button.setAttribute('aria-label', '复制代码');
        button.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(code.textContent || ''); button.textContent = '已复制'; window.dispatchEvent(new Event('blog:copied'));  }
          catch { button.textContent = '请手动复制'; }
          window.setTimeout(() => { button.textContent = '复制'; }, 1800);
        });
        const wrapper = document.createElement('div'); wrapper.className = 'code-block';
        const label = document.createElement('span'); label.className = 'code-language'; label.textContent = pre.dataset.language || code.className.replace('language-', '') || 'CODE';
        pre.replaceWith(wrapper); wrapper.append(label, button, pre);
      });
    </script>
  </body>
</html>
