---
import { getEntry, render } from 'astro:content';
import { readFile } from 'node:fs/promises';
import { parse } from 'yaml';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import ArchiveList from '../../components/ArchiveList.astro';
import TagCloud from '../../components/TagCloud.astro';
import FriendDirectory from '../../components/FriendDirectory.astro';
import Pagination from '../../components/Pagination.astro';
import Comments from '../../components/Comments.astro';
import { getPosts, taxonomy } from '../../lib/posts';
import { getListings } from '../../lib/listings';
export async function getStaticPaths() {
  const posts = await getPosts();
  return getListings(posts).filter(l => l.path !== '/').map(listing => ({ params: { listing: decodeURIComponent(listing.path.slice(1, -1)) }, props: { listing } }));
}
const { listing } = Astro.props;
const hasComments = ['page', 'tags', 'categories'].includes(listing.kind);
const posts = await getPosts();
const entry = listing.pageId ? await getEntry('pages', listing.pageId) : undefined;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const links: {name: string; link: string; description: string; avatar?: string}[] = listing.pageId === 'links' ? parse(await readFile(new URL('../../../source/links/_data/links.yml', import.meta.url), 'utf-8')) : [];
const terms = listing.kind === 'tags' || listing.kind === 'categories' ? taxonomy(posts, listing.kind) : [];
---
<Base title={listing.title} description={listing.description} canonical={listing.path} article={listing.kind === 'page'} comments={hasComments}>
  <section class:list={['listing-shell', { 'reading-page': listing.kind === 'page', 'about-page': listing.pageId === 'about', 'guestbook-page': listing.pageId === 'guestbook', 'reading-list': listing.kind === 'articles' && !listing.base.startsWith('/archives/') }]}>
    <header class="listing-header">
      <p class="breadcrumb"><a href="/">梦魇小栈</a><span aria-hidden="true"> / </span>{listing.title}</p>
      <div class="listing-heading-group">
        {listing.pageId === 'about' && <img class="about-portrait" src="/avatar.webp" width="76" height="76" alt="Ihoey 的头像" />}
        <div><h1>{listing.title}</h1><p>{listing.description}{listing.total > 0 && <span class="listing-count">共 {listing.total} {terms.length ? '个' : '篇'}</span>}</p></div>
      </div>
      {listing.pageId === 'guestbook' && <a class="guestbook-jump" href="#comments">去留言 <span aria-hidden="true">↓</span></a>}
    </header>
    {listing.kind === 'articles' && <>{listing.base.startsWith('/archives/') ? <ArchiveList posts={listing.posts} /> : <PostList posts={listing.posts} />}<Pagination page={listing.page} totalPages={listing.totalPages} base={listing.base} /></>}
    {terms.length > 0 && (listing.kind === 'tags' ? <TagCloud terms={terms} /> : <div class="taxonomy-list">{terms.map(term => <a href={term.path}><span>{term.name}</span><span>{term.count} 篇 <span aria-hidden="true">↗</span></span></a>)}</div>)}
    {Content && entry?.body?.trim() && <div class="prose page-prose"><Content /></div>}
    {links.length > 0 && <FriendDirectory links={links} notes={entry?.data.addNotes} declarations={entry?.data.declare} quote={entry?.data.quotes} />}
    {links.length === 0 && entry?.data.addNotes && <section class="prose page-prose"><h2>友链说明</h2><ul>{entry.data.addNotes.map(note => <li>{note}</li>)}</ul>{entry.data.declare?.map(note => <p>{note}</p>)}{entry.data.quotes && <blockquote>{entry.data.quotes}</blockquote>}</section>}
    {hasComments && <Comments path={listing.path} title={listing.title} />}
  </section>
</Base>
