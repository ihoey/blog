---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { getPosts, tagPath, categoryPath } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({ params: { slug: post.path.replace(/^\/posts\//, '').replace(/\.html$/, '') }, props: { post, newer: posts[index - 1], older: posts[index + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<Base title={post.data.title} description={post.description} canonical={post.path} article date={post.date} updated={post.updated}>
  <article class="article-shell">
    <div class:list={['article-grid', { 'without-toc': toc.length === 0 }]}>
      <header class="article-header"><a class="back-link" href="/archives/">← 所有文章</a><div class="article-meta"><a href={categoryPath(post.data.categories)}>{post.data.categories.join(' / ')}</a><span aria-hidden="true">·</span><time datetime={post.date.toISOString()}>{post.day}</time></div><h1>{post.data.title}</h1><div class="article-tags">{post.data.tags.map(tag => <a href={tagPath(tag)}>#{tag}</a>)}</div></header>
      <div class="article-main">
        <div class="prose"><Content /></div>
        <div class="article-end"><p>谢谢你读到这里。</p><a href="/atom.xml"><i class="icon icon-rss" aria-hidden="true"></i> 订阅 RSS</a></div>
        <nav class="adjacent-posts" aria-label="相邻文章">
          {newer && <a class="adjacent-newer" rel="prev" href={newer.path}><span><b aria-hidden="true">←</b> 上一篇</span><strong>{newer.data.title}</strong></a>}
          {older && <a class="adjacent-older" rel="next" href={older.path}><span>下一篇 <b aria-hidden="true">→</b></span><strong>{older.data.title}</strong></a>}
        </nav>
        <Comments path={post.path} title={post.data.title} />
      </div>
      {toc.length > 0 && <aside class="article-toc"><details open><summary>目录</summary><nav aria-label="文章目录">{toc.map(h => <a class:list={{ subheading: h.depth === 3 }} href={`#${h.slug}`}>{h.text}</a>)}</nav></details></aside>}
    </div>
  </article>
</Base>

<script>import "../../lib/toc";</script>
