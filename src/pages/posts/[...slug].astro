---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { getPosts, tagPath, categoryPath } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({ params: { slug: post.path.replace(/^\/posts\//, '').replace(/\.html$/, '') }, props: { post, newer: posts[index - 1], older: posts[index + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<Base title={post.data.title} description={post.description} canonical={post.path} article date={post.date} updated={post.updated}>
  <article class="article-shell">
    <header class="article-header"><a class="back-link" href="/archives/">← 所有文章</a><div class="article-meta"><a href={categoryPath(post.data.categories)}>{post.data.categories.join(' / ')}</a><span aria-hidden="true">·</span><time datetime={post.date.toISOString()}>{post.day}</time></div><h1>{post.data.title}</h1><div class="article-tags">{post.data.tags.map(tag => <a href={tagPath(tag)}>#{tag}</a>)}</div></header>
    <div class:list={['article-grid', { 'without-toc': toc.length === 0 }]}>
      <div class="article-main">
        <div class="prose"><Content /></div>
        <div class="article-end"><span aria-hidden="true">✳</span><p>谢谢你读到这里。</p><a href="/atom.xml">订阅接下来的文章 ↗</a></div>
        <nav class="adjacent-posts" aria-label="相邻文章">
          {newer && <a href={newer.path}><span>较新的文章</span>{newer.data.title}</a>}
          {older && <a href={older.path}><span>较早的文章</span>{older.data.title}</a>}
        </nav>
        <Comments path={post.path} title={post.data.title} />
      </div>
      {toc.length > 0 && <aside class="article-toc"><details open><summary>这篇文章</summary><nav aria-label="文章目录">{toc.map(h => <a class:list={{ subheading: h.depth === 3 }} href={`#${h.slug}`}>{h.text}</a>)}</nav></details></aside>}
    </div>
  </article>
</Base>
