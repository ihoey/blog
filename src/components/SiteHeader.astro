---
import Icon from './Icon.astro';
import { navigationCurrent } from '../lib/paths.mjs';
import { navigation, site } from '../data/site';
interface Props {
  article?: boolean;
}
const { article = false } = Astro.props;
const path = Astro.url.pathname;
const home = path === '/';
const BrandHeading = home ? 'h1' : 'div';
---

<div class="site-topbar">
  <div class="topbar-inner">
    <a class="topbar-brand" href="/">
      梦魇小栈
    </a>
    <nav class="main-nav" aria-label="主导航">
      {navigation.map(([href, label, icon]) => (
        <a href={href} aria-current={navigationCurrent(path, href)}>
          <Icon name={icon} />
          {label}
        </a>
      ))}
    </nav>
    <div class="header-tools" role="group" aria-label="订阅与阅读偏好">
      {article && (
        <span class="reading-track" aria-hidden="true">
          <span id="reading-progress"></span>
        </span>
      )}
      <a
        class="rss-subscribe"
        href="/atom.xml"
        aria-label="订阅 RSS"
        title="订阅 RSS"
      >
        <svg class="tool-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="rss-dot" cx="6" cy="18" r="1.5" />
          <path class="rss-wave rss-wave-near" d="M5 11a8 8 0 0 1 8 8" />
          <path class="rss-wave rss-wave-far" d="M5 5a14 14 0 0 1 14 14" />
        </svg>
      </a>
      <button
        class="sidebar-toggle"
        type="button"
        popovertarget="author-sidebar"
        aria-controls="author-sidebar"
        aria-expanded="false"
        aria-label="展开作者与分类侧栏"
        title="展开作者与分类侧栏"
        hidden
      >
        <svg class="tool-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect class="panel-glass" x="15" y="5" width="5" height="14" rx="1" />
          <rect x="3" y="4" width="18" height="16" rx="3" />
          <path class="panel-divider" d="M15 4v16" />
          <path class="panel-indicator" d="M18 8v8" />
        </svg>
      </button>
      <button
        class="theme-toggle"
        type="button"
        aria-label="切换昼夜主题"
        title="切换昼夜主题"
      >
        <svg
          class="tool-icon theme-moon"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            class="moon-body"
            d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"
          />
          <path class="moon-star" d="M18 3v4m-2-2h4" />
        </svg>
        <svg class="tool-icon theme-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="sun-core" cx="12" cy="12" r="4" />
          <path
            class="sun-rays"
            d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
          />
        </svg>
      </button>
    </div>
  </div>
</div>
<header class:list={['site-header', 'scenic-header', { 'home-header': home }]}>
  <div class="canopy" aria-hidden="true"></div>
  <div class="site-brand">
    <BrandHeading>
      <a class="site-name" href="/" aria-label="梦魇小栈首页">
        {[...'梦魇小栈'].map((letter, index) => (
          <span
            class="site-name-letter"
            style={`--letter-index:${index}`}
            aria-hidden="true"
          >
            {letter}
          </span>
        ))}
      </a>
    </BrandHeading>
    <p>{site.subtitle}</p>
  </div>
  <p class="home-quote">{site.motto}</p>
</header>
