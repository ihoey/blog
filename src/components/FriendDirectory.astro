---
import { readFile } from 'node:fs/promises';
import { parse } from 'yaml';
interface Props {
  links: { name: string; link: string; description: string; avatar?: string }[];
  notes?: string[];
  declarations?: string[];
  quote?: string;
}
const { links, notes = [], declarations = [], quote } = Astro.props;
const config = parse(await readFile('_config.yml', 'utf-8'));
const site = { name: String(config.title), url: String(config.url), description: String(config.description), avatar: String(config.avatar) };
const info = `名称：${site.name}\n地址：${site.url}\n描述：${site.description}\n图片：${site.avatar}`;
---
{quote && <blockquote class="blockquote-center">{quote}</blockquote>}
<div class="friends-toolbar">
  <div><h2>Blog friends</h2><span>{links.length} 个站点</span></div>
  <a href="#friend-exchange">申请友链 <span aria-hidden="true">↓</span></a>
</div>
<ul class="friend-list" aria-label="朋友们的站点">
  {links.map(link => <li>
    <a href={link.link} target="_blank" rel="noopener noreferrer" aria-label={`${link.name}（新窗口打开）`}>
      <span class="friend-avatar" aria-hidden="true"><span>{[...link.name][0].toLocaleUpperCase()}</span>{link.avatar && <img src={link.avatar} alt="" width="48" height="48" loading="lazy" decoding="async" referrerpolicy="no-referrer" />}</span>
      <div class="friend-identity"><h3>{link.name}</h3><span class="friend-domain">{new URL(link.link).hostname.replace(/^www\./, '')}</span></div>
      <span class="friend-arrow" aria-hidden="true">↗</span>
      <p>{link.description}</p>
    </a>
  </li>)}
</ul>
{declarations.length > 0 && <div class="friend-declarations">{declarations.map(note => <p>{note}</p>)}</div>}
<section class="friend-exchange" id="friend-exchange" aria-labelledby="friend-exchange-title">
  <div class="friend-exchange-heading"><h2 id="friend-exchange-title">交换友链</h2><a href="#comments">留言申请 <span aria-hidden="true">↗</span></a></div>
  <p class="friend-exchange-intro">在下方留言，附上你的站点名称、地址与简介。</p>
  {notes.length > 0 && <div class="friend-guidelines prose"><h3>友情链接添加须知</h3><ul>{notes.map(note => <li>{note}</li>)}</ul></div>}
  <div class="friend-site-info">
    <div class="friend-site-heading"><img src="/avatar.png" width="40" height="40" alt="梦魇小栈头像" loading="lazy" /><h3>本站链接信息</h3></div>
    <dl><div><dt>名称</dt><dd>{site.name}</dd></div><div><dt>地址</dt><dd><a href={site.url}>{site.url}</a></dd></div><div><dt>描述</dt><dd>{site.description}</dd></div><div><dt>图片</dt><dd><a href={site.avatar} target="_blank" rel="noopener noreferrer">{site.avatar}</a></dd></div></dl>
    <div class="friend-copy-actions"><button type="button" class="friend-copy" data-site-info={info} hidden>复制本站信息</button><span class="friend-copy-status" role="status"></span></div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLImageElement>('.friend-avatar img').forEach(img => {
    const fallback = () => { img.hidden = true; };
    img.addEventListener('error', fallback, { once: true });
    if (img.complete && img.naturalWidth === 0) fallback();
  });
  const copy = document.querySelector<HTMLButtonElement>('.friend-copy');
  const status = document.querySelector<HTMLElement>('.friend-copy-status');
  if (copy && status && navigator.clipboard?.writeText) {
    copy.hidden = false;
    copy.addEventListener('click', async () => {
      copy.disabled = true;
      try {
        await navigator.clipboard.writeText(copy.dataset.siteInfo || '');
        status.textContent = '已复制，可以粘贴到你的友链中。';
      } catch {
        status.textContent = '复制失败，请选中上方文字手动复制。';
      } finally {
        copy.disabled = false;
      }
    });
  }
</script>
