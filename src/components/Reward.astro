---
import '../styles/reward-legacy.css';
---
<section class="legacy-reward" data-reward aria-label="支持作者">
  <p class="reward-comment">满分是10分的话，这篇文章你给几分，您的支持将鼓励我继续创作！</p>
  <p class="reward-status" role="status" hidden></p>
  <div class="reward-content">
    <div class="reward-links">
      <a id="github" href="https://github.com/houyi1121/Playing-reward" target="_blank" rel="noopener noreferrer" class="pos-a" title="打赏组件 GitHub" aria-label="打赏组件 GitHub"></a>
      <a href="https://blog.ihoey.com/" id="DonateText" title="梦魇小栈">ihoey.com</a>
      <ul id="donateBox" class="list pos-a" aria-label="打赏方式">
        <li id="PayPal"><a href="https://www.paypal.me/ihoey" target="_blank" rel="noopener noreferrer" title="PayPal" aria-label="通过 PayPal 打赏">PayPal</a></li>
        <li id="QQ"><a href="/qcode/tencent_qcode.png" data-reward-code="QQ" title="QQ" aria-label="查看 QQ 收款码">QQ</a></li>
        <li id="AliPay"><a href="/qcode/alipay_qcode.png" data-reward-code="支付宝" title="支付宝" aria-label="查看支付宝收款码">支付宝</a></li>
        <li id="WeChat"><a href="/qcode/wechat_qcode.png" data-reward-code="微信" title="微信" aria-label="查看微信收款码">微信</a></li>
      </ul>
    </div>
    <div id="QRBox" hidden>
      <button id="MainBox" type="button" aria-label="关闭收款码"><img width="190" height="190" alt="" /></button>
      <p class="reward-qr-help">点击二维码或按 Esc 返回</p>
    </div>
  </div>
</section>
<script>import { initRewards } from '../lib/reward'; initRewards();</script>
