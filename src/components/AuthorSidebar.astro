---
import { getPosts, taxonomy } from '../lib/posts';
const posts = await getPosts();
const categories = taxonomy(posts, 'categories');
const tags = taxonomy(posts, 'tags');
const social = [
  { name: 'GitHub', href: 'https://github.com/ihoey', icon: 'github' },
  { name: '微博', href: 'http://weibo.com/hy951121', icon: 'weibo' },
  { name: 'QQ', href: 'http://wpa.qq.com/msgrd?v=3&uin=1058221214&site=qq&menu=yes', icon: 'qq' },
  { name: 'E-mail', href: 'mailto:mail@ihoey.com', icon: 'envelope' },
  { name: 'Twitter', href: 'https://twitter.com/ihoeys', icon: 'twitter' },
  { name: 'Facebook', href: 'https://www.facebook.com/profile.php?id=100008808609802', icon: 'facebook' },
];
const friends = [
  { name: 'mythsman', href: 'https://blog.mythsman.com/' },
  { name: '可乐没气的猫', href: 'https://www.isthnew.com/links' },
  { name: 'Bboysoul', href: 'http://www.bboysoul.com/' },
  { name: "jnduan's Blog", href: 'https://jnan.org/' },
  { name: "Ehlxr's Blog", href: 'https://ehlxr.me/' },
];
---
<aside id="author-sidebar" class="author-sidebar" aria-label="作者与分类">
  <div class="author-profile">
    <a class="avatar-link" href="/about/" aria-label="认识 Ihoey"><img src="/avatar.png" width="88" height="88" alt="Ihoey 的头像" /></a>
    <h2>Ihoey</h2><p class="author-motto">心，若没有栖息的地方，<br />到哪里都是流浪……</p>
    <div class="author-stats"><a href="/archives/"><b>{posts.length}</b>文章</a><a href="/categories/"><b>{categories.length}</b>分类</a><a href="/tags/"><b>{tags.length}</b>标签</a></div>
    <nav class="author-social" aria-label="联系作者">{social.map(link => <a href={link.href} target={link.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer"><i class={`icon icon-${link.icon}`} aria-hidden="true"></i><span>{link.name}</span></a>)}</nav>
    <a class="author-feed" href="/atom.xml"><i class="icon icon-rss" aria-hidden="true"></i> 订阅 RSS <span aria-hidden="true">↗</span></a>
  </div>
  <nav class="sidebar-topics" aria-label="文章分类"><h3>分类</h3><a href="/" aria-current="page"><span>全部文章</span><span>{posts.length}</span></a>{categories.slice(0,6).map(c => <a href={c.path}><span>{c.name}</span><span>{c.count}</span></a>)}<a href="/categories/"><span>所有分类</span><span aria-hidden="true">→</span></a></nav>
  <nav class="sidebar-friends" aria-label="友情链接"><h3>友邻</h3>{friends.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer"><span>{link.name}</span><span aria-hidden="true">↗</span></a>)}<a class="all-friends" href="/links/"><span>所有友链</span><span aria-hidden="true">→</span></a></nav>
</aside>
