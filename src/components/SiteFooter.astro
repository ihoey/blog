---
import { site } from '../data/site';
import Icon from './Icon.astro';
import FooterLandscape from './FooterLandscape.astro';
---

<footer class="site-footer">
  <FooterLandscape />
  <div class="footer-content">
    <div class="footer-main">
      <div class="footer-identity">
        <div class="footer-brand">
          <a class="footer-name" href="/">
            梦魇小栈
          </a>
          <span class="hitalk-secret" data-hitalk-secret>
            <button
              type="button"
              aria-label="叫小猫出来"
              title="叫小猫出来"
            ></button>
          </span>
        </div>
        <p class="footer-motto">{site.motto}</p>
        <nav class="footer-links" aria-label="小栈链接">
          <a class="footer-rss" href="/atom.xml">
            <Icon name="rss" /> 订阅 RSS
          </a>
          <a href="/sitemap.xml">站点地图</a>
          <a
            href="https://github.com/ihoey"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" /> GitHub
          </a>
          <a class="footer-guestbook" href="/guestbook/index.html">
            <Icon name="comment" /> 留个言 <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
      <div class="footer-status">
        <p class="uptime-label">
          博客已萌萌哒运行 <span class="uptime-face">●'◡'●)ﾉ♥</span>
        </p>
        <p class="site-uptime">
          <span data-uptime>从 2015 年至今</span>
        </p>
        <div class="site-traffic" aria-label="访问统计">
          <span id="busuanzi_container_site_uv">
            <Icon name="user" /> 访客 <span id="busuanzi_value_site_uv">—</span>
          </span>
          <span id="busuanzi_container_site_pv">
            <Icon name="eye" /> 访问 <span id="busuanzi_value_site_pv">—</span>{' '}
            次
          </span>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>
        © 2015–{new Date().getFullYear()}{' '}
        <img
          class="footer-heart"
          src="/design/reward/like.svg"
          width="18"
          height="18"
          alt=""
          aria-hidden="true"
        />{' '}
        梦魇小栈
      </span>
      <a
        href="https://beian.miit.gov.cn/"
        rel="noopener noreferrer"
        target="_blank"
      >
        京ICP备15058055号-1
      </a>
      <span>
        由{' '}
        <a
          href="https://github.com/ihoey"
          rel="noopener noreferrer"
          target="_blank"
        >
          Ihoey
        </a>{' '}
        用心维护
      </span>
    </div>
  </div>
</footer>
<button class="back-top" type="button" aria-label="返回顶部" hidden>
  <span class="back-top-label" aria-hidden="true">
    回到顶部
  </span>
  <svg
    class="back-top-rocket"
    viewBox="0 0 32 44"
    fill="none"
    aria-hidden="true"
  >
    <g class="rocket-flame">
      <path d="M12 31q0 7 4 10 4-3 4-10" />
      <path d="M16 32v4" />
    </g>
    <g class="rocket-body">
      <path class="rocket-fins" d="m10 20-5 6v7l7-4m10-9 5 6v7l-7-4" />
      <path d="M10 29C7 16 11 7 16 3c5 4 9 13 6 26Z" />
      <path d="M11 29h10l-1 3h-8Z" />
      <circle cx="16" cy="16" r="3" />
    </g>
  </svg>
</button>
