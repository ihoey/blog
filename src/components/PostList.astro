---
import Icon from './Icon.astro';
import { categoryPath, type Post } from '../lib/posts';
interface Props { posts: Post[]; compact?: boolean; headingLevel?: 'h2' | 'h3' }
const { posts, compact = false, headingLevel: Heading = 'h2' } = Astro.props;
---
<div class:list={['post-list', { compact }]}>
  {posts.map(post => <article class="post-row">
    <div class="post-summary">
      <header class="post-list-header">
        <Heading><a class:list={[{ 'text-link': Heading === 'h2' }]} href={post.path}>{post.data.title}</a></Heading>
        <div class="post-meta">
          <span><Icon name="calendar" /> 发布于 <time datetime={post.date.toISOString()}>{post.day}</time></span>
          {!compact && post.updatedDay !== post.day && <span><Icon name="updated" /> 更新于 <time datetime={post.updated.toISOString()}>{post.updatedDay}</time></span>}
          <span><Icon name="folder" /> {post.data.categories.map((name, i) => <>{i > 0 && <span aria-hidden="true"> / </span>}<a class="post-category" href={categoryPath(post.data.categories.slice(0, i + 1))}>{name}</a></>)}</span>
        </div>
        {!compact && <div class="post-reading-meta">
          <span title="正文字符数，含代码，不含空白和 Markdown 标记"><Icon name="file-text" /> {post.preview.wordCount.toLocaleString('zh-CN')} 字</span>
          <span title="按正文长度和代码行数估算"><Icon name="clock" /> 约 {post.preview.readingMinutes} 分钟</span>
          <a class="discussion-link" href={`${post.path}#comments`}><Icon name="comment" /> 评论<span class="hitalk-comment-count" data-xid={post.path}></span></a>
        </div>}
      </header>
      {!compact && <div class="post-excerpt" set:html={post.preview.html} />}
      {!compact && <div class="post-actions"><a class="read-link text-link" href={post.path}>阅读全文 <span aria-hidden="true">→</span></a></div>}
    </div>
    {!compact && <div class="scissor-divider" aria-hidden="true"><span class="scissor-track"><Icon name="scissors" /></span></div>}
  </article>)}
</div>
<script>
  import { loadCommentCounts } from '../lib/comments';
  loadCommentCounts();
</script>
