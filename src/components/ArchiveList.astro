---
import PostList from './PostList.astro';
import type { Post } from '../lib/posts';

interface Props { posts: Post[] }
const { posts } = Astro.props;
const groups = new Map<string, Post[]>();
for (const post of posts) {
  const year = post.day.slice(0, 4);
  if (!groups.has(year)) groups.set(year, []);
  groups.get(year)!.push(post);
}
---
<div class="archive-years">
  {[...groups].map(([year, entries]) => <section class="archive-year-group" aria-labelledby={`archive-year-${year}`}>
    <h2 class="archive-year-heading" id={`archive-year-${year}`}><a href={`/archives/${year}/`}>{year}<span>年</span></a></h2>
    <PostList posts={entries} compact headingLevel="h3" />
  </section>)}
</div>
